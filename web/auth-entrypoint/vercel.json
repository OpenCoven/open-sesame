{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "installCommand": "",
  "outputDirectory": "dist",
  "rewrites": [{"source": "/auth/login", "destination": "/auth/login/index.html"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "Cache-Control", "value": "no-store"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"}
  ]}]
}
