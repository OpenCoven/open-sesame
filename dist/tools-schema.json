{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Sesame tool v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "author",
    "license",
    "config",
    "capabilities",
    "source",
    "components",
    "actions",
    "presentations",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "config": {
      "type": "object",
      "maxProperties": 12,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "default"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "default": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "github.summary",
          "feeds.headlines",
          "note.save",
          "navigate",
          "link.open"
        ]
      }
    },
    "source": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "enum": [
                "github.summary",
                "feeds.headlines"
              ]
            }
          }
        }
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "label"
        ],
        "properties": {
          "type": {
            "enum": [
              "text",
              "metric",
              "list",
              "input"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "input"
                }
              }
            },
            "then": {
              "required": [
                "field"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "metric"
                  ]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "field"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "list"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "field"
                ]
              }
            }
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "operation",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "operation": {
            "enum": [
              "navigate",
              "link.open",
              "note.save"
            ]
          },
          "value": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "presentations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "launcher",
          "card",
          "panel"
        ]
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "count",
        "entries"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "count": {
          "type": "number"
        },
        "entries": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "operation": {
                "const": "github.summary"
              }
            },
            "required": [
              "operation"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "repository"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "operation": {
                "const": "feeds.headlines"
              }
            },
            "required": [
              "operation"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "feed"
            ]
          }
        }
      }
    }
  ]
}
